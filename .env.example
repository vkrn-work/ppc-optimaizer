POSTGRES_PASSWORD=change_me

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# LLM-провайдер для анализа — выбирается на фронте перед запуском,
# нужен ключ хотя бы для одного. Бесплатные варианты для тестов: Gemini, Groq, OpenRouter.

# Claude (платный, без постоянного бесплатного тарифа)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Gemini (бесплатно, без карты) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (бесплатно, без карты) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (бесплатные модели, без карты) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

SECRET_KEY=change_this_secret_key
ALLOWED_ORIGINS=http://localhost:3000
